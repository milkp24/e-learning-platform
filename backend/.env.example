# Flask Configuration
FLASK_APP=app.py
FLASK_DEBUG=True
SECRET_KEY=elearning-dev-secret-key-change-in-production

# JWT Configuration
JWT_SECRET_KEY=elearning-dev-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elearning_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elearning_db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173

# Frontend URL Configuration (สำหรับสร้างลิงก์ Reset Password)
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (สำหรับส่งอีเมล Reset Password)
# หากใช้ Gmail: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USE_TLS=true
# และสร้าง App Password 16 หลักจาก Google Account Settings (ห้ามใช้รหัสผ่านปกติของบัญชี)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_USE_TLS=true
MAIL_FROM=your-email@gmail.com

