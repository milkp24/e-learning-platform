# Flask Application Configuration
FLASK_APP=app.py
FLASK_DEBUG=True
SECRET_KEY=your-dev-secret-key-change-in-production

# JWT Authentication Configuration
# Access token expiration aligned with system session timeout (30 minutes)
JWT_SECRET_KEY=your-dev-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=elearning_db
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/elearning_db

# CORS Configuration (Comma-separated origins allowed to make API requests)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend URL Configuration (Used for password reset links and redirection)
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (Used for password reset verification emails)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your-email-password-or-app-key
MAIL_USE_TLS=true
MAIL_FROM=noreply@example.com
